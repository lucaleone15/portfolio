{
  "name": "luca-leone-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && npm run build:server",
    "start": "node dist-server/index.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-ssr dist-server",
    "lint": "tsc --noEmit",
    "build:server": "esbuild server/index.ts server/mailTest.ts server/admin/setup.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist-server --out-extension:.js=.mjs",
    "mail:test": "node dist-server/mailTest.mjs",
    "images": "python3 scripts/make-image-variants.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:setup": "node dist-server/admin/setup.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.13",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "0.33.5",
    "vite": "^6.2.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.25.0",
    "jsdom": "25.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "3.0.5"
  }
}
