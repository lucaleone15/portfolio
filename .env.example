# Contact form (POST /api/contact, server/contact.ts)
# Copy this file to .env and fill in the SMTP account of your own mailbox
# (e.g. luca@luca-leone.ch). .env is git-ignored: never commit real credentials.
SMTP_HOST="mail.example.com"
# 465 = TLS (most providers), 587 = STARTTLS
SMTP_PORT="465"
SMTP_USER="luca@luca-leone.ch"
SMTP_PASS="your-mailbox-or-app-password"
# Optional: recipient (defaults to SMTP_USER) and sender (defaults to SMTP_USER)
CONTACT_TO="luca@luca-leone.ch"
SMTP_FROM="luca@luca-leone.ch"

# Production server port (npm start)
PORT="3000"

# Admin dashboard (server/admin/). All three below are needed, otherwise the admin is off
# (every admin address gets the site's 404). Generate the last two with: npm run admin:setup
# An address that is hard to guess, e.g. /atelier-7k2q9 (never linked anywhere)
ADMIN_PATH=""
ADMIN_PASSWORD_HASH=""
ADMIN_TOTP_SECRET=""
# "git" on the server (Publish = pull, commit, build, push), "files" locally (writes content/ only)
ADMIN_PUBLISH_MODE="files"
# Private key of a GitHub deploy key with write access (server only), and the commits' author
ADMIN_GIT_SSH_KEY=""
ADMIN_GIT_NAME="Luca Leone (dashboard)"
ADMIN_GIT_EMAIL="luca@luca-leone.ch"
